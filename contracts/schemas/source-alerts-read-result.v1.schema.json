{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-alerts-read-result.v1.schema.json",
  "allOf": [
    {
      "$ref": "message-envelope.v1.schema.json"
    },
    {
      "properties": {
        "message_type": {
          "const": "source.alerts.read.result"
        },
        "payload": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "ok",
                "forbidden"
              ]
            },
            "items": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "source_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "domain": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 253
                  },
                  "occurred_at": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "id",
                  "source_id",
                  "domain",
                  "occurred_at"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "status",
            "items"
          ],
          "additionalProperties": false
        }
      }
    }
  ]
}
